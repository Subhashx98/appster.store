        "faq_rxADmF": {
          "type": "faq",
          "settings": {
            "faq_que": "What is Wire Duct?",
            "faq_ans": "<p>Wiring duct is an easy way to channel your wires and cables. It is made of a rigid PVC that helps protect your wires from debris. <a href=\"/blogs/articles/cable-management-tips-resources\" target=\"_blank\" title=\"Cable Management Tips & Resources\"><strong>...more</strong></a><br/><br/>Wire Ducts have slots where wires can exit and be rerouted if needed. <a href=\"/blogs/articles/desk-cable-organizers\" target=\"_blank\" title=\"Desk Cable Organizers\"><strong>...more</strong></a></p>"
          }
