    "faq_question_answer_HjFLiq": {
      "type": "faq-question-answer",
      "blocks": {
        "faq_Nf6kPU": {
          "type": "faq",
          "settings": {
            "faq_que": "Which Cord Cover Should I Use For An Outdoor Event?",
            "faq_ans": "<p>Extra-Rugged Rubber Ducts are a great option for covering cables and wires that are snaking through your yard and walkways. <a href=\"/blogs/articles/4-fast-easy-and-affordable-ways-to-hide-and-protect-speaker-wire\" target=\"_blank\" title=\"4 Fast, Easy, and Affordable Ways to Hide and Protect Speaker Wire\"><strong>...more</strong></a></p>"
          }
