  //ReadMore Button 
  $(document).ready(function () {

    function toggleText(button) {
      var $paragraph = $(button).prev('p');
      var isExpanded = $paragraph.css('webkit-line-clamp') === 'none';

      if (isExpanded) {
        $paragraph.css('webkit-line-clamp', '5');
        $(button).text('Read More');
      } else {
        $paragraph.css('webkit-line-clamp', 'none');
        $(button).text('Read Less');
      }
    }

    $('.slider-block-text').each(function () {
      var $paragraph = $(this).find('p');
      var paragraphHeight = $paragraph[0].scrollHeight;
      var visibleHeight = $paragraph.height();

      if (paragraphHeight > visibleHeight) {
        $(this).find('.read-more-btn').show();
      }
    });

    $('.read-more-btn').click(function () {
      toggleText(this);
    });
  });

</script>
{% schema %}
{
  "name": "Collection Slider",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "slider_heading",
      "label": "Heading",
      "default": "Cable Management Tips & Resources"
    }
  ],
  "presets": [
    {
      "name": "Collection Slider"
    }
  ]
}
{% endschema %}