{{ 'section-discover.css' | asset_url | stylesheet_tag }}

<div class="section-descover">
  <div class="page-width">
    <div class="descover-main">
      {% if section.settings.heading != blank %}
        <div class="descover-title">
          <h2>{{ section.settings.heading }}</h2>
        </div>
      {% endif %}
      {% for block in section.blocks %}
        <div class="row {% if block.settings.media_alignment %}row-reverse{% endif %}">
          <div class="col-6">
            <div class="descover-block">
              {% if block.settings.media_selection == 'image' %}
                <img
                  src="{{ block.settings.image_url | image_url }}"
                  alt="Descover Image"
                  loading="lazy"
                  width=""
                  height=""
                >
              {% elsif block.settings.media_selection == 'video' %}
                {{ block.settings.video_url | video_tag: autoplay: true, loop: true, muted: true, controls: false }}
              {% endif %}
            </div>
          </div>
          <div class="col-6">
            <div class="descover-content">
              <h2>{{ block.settings.title }}</h2>
              {{ block.settings.description }}
              {% if block.settings.button_text != blank and block.settings.button_url != blank %}
                <a href="{{ block.settings.button_url }}" class="main-cta">{{ block.settings.button_text }}</a>
              {% endif %}
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "discover Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "discover_block",
      "name": "Discover Block",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "image_picker",
          "id": "image_url",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video_url",
          "label": "Video"
        },
        {
          "type": "select",
          "id": "media_selection",
          "label": "Select Media Type",
          "options": [
            {
              "value": "image",
              "label": "Image"
            },
            {
              "value": "video",
              "label": "Video"
            }
          ],
          "default": "video"
        },
        {
          "type": "checkbox",
          "id": "media_alignment",
          "label": "Make Image right align",
          "default": false
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "discover Section"
    }
  ]
}
{% endschema %}
