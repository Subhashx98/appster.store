{{ 'section-collection-banner.css' | asset_url | stylesheet_tag }}


  <div class="collection-banner">
    {% if section.settings.heading != blank
      or section.settings.content != blank
      or section.settings.link != blank
      or section.settings.cta_text != blank
    %}
      <div class="collection-content">
        <div class="page-width">
          <div class="content-left">
            {% if section.settings.logo_image != blank %}
              <span class="collection-logo-img">
                <img
                src="{{ section.settings.logo_image | image_url }}"
                alt="{{ section.settings.heading }}"
                height="86"
                width="220"
                loading="lazy">
              </span>
            {% endif %}
            {% if section.settings.heading != blank %}
              <h2>{{ section.settings.heading }}</h2>
            {% endif %}
            {% if section.settings.content != blank %}
              {{ section.settings.content }}
            {% endif %}
            {% if section.settings.link != blank and section.settings.cta_text != blank %}
              <a href="{{ section.settings.link }}" class="main-btn-large btn-blue">{{ section.settings.cta_text }}</a>
            {% endif %}
          </div>
        </div>
      </div>
    {% endif %}
    {% if section.settings.image != blank %}
      <div class="collection-content-img">
        <div class="page-width">
          {% if section.settings.image != blank %}
            <span
              ><img
                src="{{ section.settings.image | image_url }}"
                alt="{{ section.settings.heading }}"
                height="490"
                width="800"
                loading="lazy"
            ></span>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>


{% schema %}
{
  "name": "Collection Banner",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    }
    
  ],
  "presets": [
    {
      "name": "Collection Banner"
    }
  ]
}
{% endschema %}
