{% if section.settings.image != blank or section.settings.brand_logo != blank %}
  <div class="main-img-banner brand-banner {% if section.settings.image == blank %}banner-image-hidden{% endif %}">
    {% if section.settings.image != blank %}
      <span class="main-banner-bg">
        <img
          src="{{ section.settings.image |  image_url }}"
          alt="{{ section.settings.image.alt |  default: "Brand Image"}}"
          height="132"
          width="100%"
          loading="lazy"
        >
      </span>
    {% endif %}
    <div class="banner-brand-logo">
      <div class="page-width">
        {% if section.settings.brand_logo != blank %}
          <h1><img
            src="{{ section.settings.brand_logo |  image_url }}"
            alt="{{ section.settings.brand_logo.alt |  default: "Brand Logo"}}"
            height="70"
            width="340"
            loading="lazy"
          ></h1>
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Brand Specific Banner",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner Image"
    },
    {
      "type": "image_picker",
      "id": "brand_logo",
      "label": "Brand Logo"
    }
  ],
  "presets": [
    {
      "name": "Brand Specific Banner"
    }
  ]
}
{% endschema %}
