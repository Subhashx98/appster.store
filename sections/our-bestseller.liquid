{{ 'section-our-bestsellers.css' | asset_url | stylesheet_tag }}

<div class="section-our-bestsellers">
  <div class="page-width">
    <div class="title-box">
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}
      <div class="right-corner">
        <div class="progress-bar">
          <span class="slider__label sr-only"></span>
        </div>
        <div class="d-flex">
          <div class="prevArrow slide-button">
            {%- render 'previous-icon' -%}
          </div>
          <div class="nextArrow slide-button">
            {% render 'next-icon' %}
          </div>
        </div>
      </div>
    </div>
    {% if section.settings.products != blank %}
      <div class="product-slider">
        {% for product in section.settings.products %}
          {%- render 'product-item', product: product, section_id: section.id -%}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

<script>
  $(document).ready(function () {
    $('.section-our-bestsellers').each(function () {
      var $container = $(this);
      var $slider = $container.find('.product-slider');
      var $progressBar = $container.find('.progress-bar');
      var $progressBarLabel = $container.find('.slider__label');
      var $nextArrow = $container.find('.nextArrow');
      var $prevArrow = $container.find('.prevArrow');

      // Initialize the Slick slider
      $slider.slick({
        dots: false,
        infinite: true,
        speed: 300,
        slidesToShow: 4,
        slidesToScroll: 1,
        nextArrow: $nextArrow,
        prevArrow: $prevArrow,
        responsive: [
          {
            breakpoint: 1200,
            settings: {
              slidesToShow: 3,
            },
          },
          {
            breakpoint: 900,
            settings: {
              slidesToShow: 2,
            },
          },
          {
            breakpoint: 576,
            settings: {
              slidesToShow: 1,
              variableWidth: true,
            },
          },
          {
            breakpoint: 358,
            settings: {
              slidesToShow: 1,
              variableWidth: false,
            },
          },
        ],
      });

      // Set initial progress bar state
      var initialProgress = 20; // 20% starting background
      $progressBar.css('background-size', initialProgress + '% 100%').attr('aria-valuenow', initialProgress);
      $progressBarLabel.text(initialProgress + '% completed');

      // Update progress bar on slide change
      $slider.on('beforeChange', function (event, slick, currentSlide, nextSlide) {
        var slideCount = slick.slideCount; // Total number of slides
        var calc = ((nextSlide + 1) / slideCount) * 100; // Calculate progress

        // Update progress bar
        $progressBar.css('background-size', calc + '% 100%').attr('aria-valuenow', calc);
        $progressBarLabel.text(calc.toFixed(0) + '% completed');
      });
    });
  });
  document.getElementById('increase-qty').addEventListener('click', function () {
    var qtyInput = document.querySelector('.quantity_input');
    qtyInput.value = parseInt(qtyInput.value) + 1;
  });

  document.getElementById('decrease-qty').addEventListener('click', function () {
    var qtyInput = document.querySelector('.quantity_input');
    if (parseInt(qtyInput.value) > 1) {
      qtyInput.value = parseInt(qtyInput.value) - 1;
    }
  });
</script>

{% schema %}
{
  "name": "Our Bestsellers",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Bestsellers"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Select Products"
    }
  ],
  "presets": [
    {
      "name": "Our Bestsellers"
    }
  ]
}
{% endschema %}
