{{ 'section-top-collection.css' | asset_url | stylesheet_tag }}

<div class="page-width">
  <div class="shop-all-collection">
    <h2 class="section-main-title">
      {{ section.settings.heading }}
      <a href="{{ section.settings.cta_url }}" class="view-link">{{ section.settings.cta_text }}</a>
    </h2>
    <div class="collection-slider">
      <div class="top-collection-slider">
        {% for collections in section.settings.collection %}
          <div class="slick-slide">
            <div>
              <span class="collection-item-img">
                <img
                  src="{{ collections.image |  image_url }}"
                  alt="{{ collections.image.alt |  default: collections.title }}"
                  height="205"
                  width="205"
                  loading="lazy"
                >
              </span>
              <a href="{{ collections.url }}">{{ collections.title }}</a>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>
{% comment %} Script {% endcomment %}
<script>
  // Slider
  $(document).ready(function () {
    $('.top-collection-slider').slick({
      slidesToShow: 6,
      slidesToScroll: 1,
      infinite: false,
      speed: 300,
      lazyLoad: 'ondemand',
      responsive: [
        {
          breakpoint: 992,
          settings: {
            slidesToShow: 4,
          },
        },
        {
          breakpoint: 768,
          settings: {
            slidesToShow: 2,
          },
        },
      ],
    });
  });
</script>
{% schema %}
{
  "name": "Shop Top Collection",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Link"
    },
    {
      "type": "collection_list",
      "id": "collection",
      "label": "Select Collection"
    }
  ],
  "presets": [
    {
      "name": "Shop Top Collection"
    }
  ]
}
{% endschema %}
