{{ 'section-about-us.css' | asset_url | stylesheet_tag }}

<div class="page-width page-small-width">
  <div class="about-content">
    {% if section.settings.heading != blank or section.settings.description != blank %}
      <div class="about-us-title">
        {% if section.settings.heading != blank %}
          <h1>{{ section.settings.heading }}</h1>
        {% endif %}
        {% if section.settings.description != blank %}
          {{ section.settings.description }}
        {% endif %}
      </div>
    {% endif %}
    <div class="about-us-image">
      {% if section.settings.bg_img != blank %}
        <span class="about-bg-image">
          <img
            src="{{ section.settings.bg_img |  image_url }}"
            alt="{{ section.settings.bg_img.alt |  default: section.settings.heading }}"
            height="520"
            width="1240"
            loading="lazy"
          >
        </span>
      {% endif %}
      <ul class="about-icon-text">
        {% for block in section.blocks %}
          {% if block.type == 'icon_text_block' %}
            {% if block.settings.icon != blank or block.settings.text != blank %}
            <li>
                {% if block.settings.icon != blank %}
                <img
                  src="{{ block.settings.icon |  image_url }}"
                  alt="{{ block.settings.text }}"
                  height="18"
                  width="18"
                  loading="lazy"
                >
              {% endif %}
              {% if block.settings.text != blank %}
              <span>{{ block.settings.text }}</span>
              {% endif %}
            </li>
            {% endif %}
          {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "About Us Content",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "image_picker",
      "id": "bg_img",
      "label": "Background Image"
    }
  ],
  "blocks": [
    {
      "type": "icon_text_block",
      "name": "Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Us Content"
    }
  ]
}
{% endschema %}
