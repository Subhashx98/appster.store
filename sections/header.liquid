<script>
  $(document).ready(function () {
    const $maniItemWithSubChild = $('.list-menu--inline .has-sub-child');

    // Handle first-level menu click
    $maniItemWithSubChild.on('click', function (e) {
      // Only prevent default if the click isn't on a link inside .product_list
      if (!$(e.target).closest('.second-level-mega-menu-wrapper, .featured-products-container').length) {
        e.preventDefault();
      }

      // If the click is inside .product_list, let it proceed (e.g., follow the link)
      if ($(e.target).closest('.second-level-mega-menu-wrapper, .featured-products-container').length) {
        return; // Exit early, allowing the link to work
      }
      closeAllMenus();
      $(this).addClass('active');
      $(this).children('.first-menu').addClass('active');
      $('body').addClass('menu-active');
    });

    // Close all menus when clicking anywhere on the document
    $(document).on('click', '.overlay-bg', function () {
      closeAllMenus();
      $('body').removeClass('menu-active');
    });

    // Function to close all open menus
    function closeAllMenus() {
      $maniItemWithSubChild.removeClass('active');
      $maniItemWithSubChild.find('.first-menu').removeClass('active');
    }

    $('.second-level-menu li').on('mouseenter', function () {
      // Remove active class from all menu items
      $('.second-level-menu li').removeClass('active');

      // Add active class to hovered item
      $(this).addClass('active');

      // Get the tab ID from data attribute
      var tabId = $(this).data('tabid');

      // Hide all menu-wrap sections
      $('.menu-wrap').addClass('hidden');

      // Show the selected menu-wrap section
      $('.menu-wrap.' + tabId).removeClass('hidden');
    });

    $('.menu-box > ul > li').on('mouseenter', function () {
      // Remove active class from all menu items
      $('.menu-box > ul > li').removeClass('active');

      // Add active class to hovered item
      $(this).addClass('active');

      // Hide all product-card-block sections
      $('.product-card-block').addClass('hidden');

      // Show the product-card-block within the hovered li
      $(this).find('.product-card-block').removeClass('hidden');
    });

    // Handle responsive menu clicks
    const $mobileTopLevelMenu = $('.responsive li.menu-has-child');

    $($mobileTopLevelMenu)
      .find('.submenu-trigger')
      .on('click', function (e) {
        e.preventDefault();
        e.stopPropagation();

        const $parentLi = $(this).closest('li.menu-has-child');
        const $allMenus = $('.responsive li.menu-has-child');

        // Close all other open menus
        $allMenus.not($parentLi).removeClass('active').find('.mb-second-level-menu').slideUp(300);

        // Toggle the clicked menu
        $parentLi.toggleClass('active');
        $parentLi.find('.mb-second-level-menu').slideToggle(300);
      });

    // Handle responsive sub-menu clicks
    $(document).on('click', '.menu-has-sec-child .secondmenu-trigger-container .secondmenu-trigger', function (e) {
      e.preventDefault();
      e.stopPropagation();

      const $currentMenuWrap = $(this).closest('.menu-has-sec-child').find('.menu-wrap, .mobile_featured_product');
      const $parentMenu = $(this).closest('.sub-menu');

      // Close other open submenus within the same parent menu
      $parentMenu
        .find('.menu-wrap, .mobile_featured_product')
        .not($currentMenuWrap)
        .slideUp()
        .closest('.menu-has-sec-child')
        .removeClass('active');

      // Toggle the clicked menu's menu-wrap
      $currentMenuWrap.slideToggle().closest('.menu-has-sec-child').toggleClass('active');
    });

    // Handle responsive sub-menu clicks
    $(document).on(
      'click',
      '.menu-drawer__navigation ul li.active .mb-second-level-menu ul li.active .menu-wrap .menu-box ul li .thirdmenu-trigger',
      function (e) {
        e.preventDefault();
        e.stopPropagation();

        const $clickedLi = $(this).closest('li');
        const $menuItems = $(
          '.menu-drawer__navigation ul li.active .mb-second-level-menu ul li.active .menu-wrap .menu-box ul li'
        );
        const $productCardBlock = $('.product-card-block');

        // Remove 'current' class from all menu items except the clicked one
        $menuItems.not($clickedLi).removeClass('current');

        // Toggle 'current' class on clicked menu item
        $clickedLi.toggleClass('current');

        // Ensure only the clicked item's product card block is shown
        $productCardBlock.slideUp(300);
        if ($clickedLi.hasClass('current')) {
          $clickedLi.find('.product-card-block').slideDown(300);
        }
      }
    );
  });
</script>

<script>
  $(document).ready(function () {
    $('.select_link').on('click', function (e) {
      e.stopPropagation();
      var $categoriesDropmenu = $(this).closest('.categories_dropmenu');
      var $menuBlockDropmenu = $categoriesDropmenu.find('.menu_block_dropmenu');
      $categoriesDropmenu.toggleClass('open');
      $menuBlockDropmenu.toggleClass('open');
    });

    // When clicking outside of the categories_dropmenu, close the dropdown menu
    $(document).on('click', function (e) {
      if (
        !$(e.target).closest('.categories_dropmenu').length &&
        !$(e.target).closest('.co-header-megamenu .header .header__inline-menu ul.list-menu li').length
      ) {
        $('.categories_dropmenu').removeClass('open');
        $('.menu_block_dropmenu').removeClass('open');
      }
    });

    $('.categories_dropmenu').on('click', function (e) {
      e.stopPropagation();
    });

    // close dropdown when clicking on any list item inside the menu
    $('.co-header-megamenu .header .header__inline-menu ul.list-menu li').on('click', function () {
      $('.categories_dropmenu').removeClass('open');
      $('.menu_block_dropmenu').removeClass('open');
    });
  });
</script>
{% schema %}
{
  "name": "t:sections.header.name",
  "class": "section-header",
  "max_blocks": 10,
  "settings": [
    {
      "type": "select",
      "id": "logo_position",
      "options": [
        {
          "value": "top-left",
          "label": "t:sections.header.settings.logo_position.options__2.label"
        },
        {
          "value": "top-center",
          "label": "t:sections.header.settings.logo_position.options__3.label"
        },
        {
          "value": "middle-left",
          "label": "t:sections.header.settings.logo_position.options__1.label"
        },
        {
          "value": "middle-center",
          "label": "t:sections.header.settings.logo_position.options__4.label"
        }
      ],
      "default": "middle-left",
      "label": "t:sections.header.settings.logo_position.label",
      "info": "t:sections.header.settings.logo_help.content"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "t:sections.header.settings.menu.label"
