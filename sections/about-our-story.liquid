{{ 'section-our-story.css' | asset_url | stylesheet_tag }}

<div class="page-width page-small-width">
  {% if section.settings.heading != blank
    or section.settings.description != blank
    or section.settings.image_1 != blank
    or section.settings.image_2 != blank
    or section.settings.full_img != blank
  %}
    <div class="about-our-story">
      {% if section.settings.heading != blank or section.settings.description != blank %}
        <div class="about-story-colunm">
          {% if section.settings.heading != blank %}
            <h2>{{ section.settings.heading }}</h2>
          {% endif %}
          {% if section.settings.description != blank %}
            {{ section.settings.description }}
          {% endif %}
        </div>
      {% endif %}
      {% if section.settings.image_1 != blank
        or section.settings.image_2 != blank
        or section.settings.full_img != blank
      %}
        <div class="about-story-colunm">
          {% if section.settings.image_1 != blank or section.settings.image_2 != blank %}
            <div class="story-images-main">
              {% if section.settings.image_1 != blank %}
                <span class="story-images-half">
                  <img
                    src="{{ section.settings.image_1 |  image_url }}"
                    alt="{{ section.settings.image_1.alt |  default: section.settings.heading }}"
                    height="280"
                    width="310"
                    loading="lazy"
                  >
                </span>
              {% endif %}
              {% if section.settings.image_2 != blank %}
                <span class="story-images-half">
                  <img
                    src="{{ section.settings.image_2 |  image_url }}"
                    alt="{{ section.settings.image_2.alt |  default: section.settings.heading }}"
                    height="280"
                    width="310"
                    loading="lazy"
                  >
                </span>
              {% endif %}
            </div>
          {% endif %}
          {% if section.settings.full_img != blank %}
            <div class="story-images-main">
              {% if section.settings.full_img != blank %}
                <span class="story-images-full">
                  <img
                    src="{{ section.settings.full_img |  image_url }}"
                    alt="{{ section.settings.full_img.alt |  default: section.settings.heading }}"
                    height="580"
                    width="260"
                    loading="lazy"
                  >
                </span>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>
  {% endif %}
</div>
{% schema %}
{
  "name": "About Our Story",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "full_img",
      "label": "Full Image"
    }
  ],
  "presets": [
    {
      "name": "About Our Story"
    }
  ]
}
{% endschema %}
