{{ 'section-shop-product.css' | asset_url | stylesheet_tag }}
<div class="page-width">
  <div class="shop-product">
    {% for block in section.blocks %}
      {% if block.type == 'product_detail_block' %}
        {% if block.settings.image != blank
          or block.settings.heading != blank
          or block.settings.description != blank
          or block.settings.cta_url != blank
          or block.settings.cta_text != blank
        %}
          <div class="shop-product-details">
            {% if block.settings.image != blank %}
              <span class="shop-bg-image">
                <img
                  src="{{ block.settings.image |  image_url }}"
                  alt="{{ block.settings.image.alt |  default: block.settings.heading }}"
                  height="490"
                  width="490"
                  loading="lazy"
                >
              </span>
            {% endif %}
            {% if block.settings.logo_image != blank %}
              <div class="shop-logo">
                <img
                  src="{{ block.settings.logo_image |  image_url }}"
                  alt="{{ block.settings.logo_image.alt |  default: block.settings.heading |  default: 'CableOrganizer®' }}"
                  height="50"
                  width="100"
                  loading="lazy"
                >
              </div>
            {% endif %}
            {% if block.settings.heading != blank %}
              <h3>{{ block.settings.heading }}</h3>
            {% endif %}
            {% if block.settings.description != blank %}
              <p>{{ block.settings.description }}</p>
            {% endif %}
            {% if block.settings.cta_url and block.settings.cta_text != blank %}
              <a href="{{ block.settings.cta_url }}" class="main-btn-large btn-white">{{ block.settings.cta_text }}</a>
            {% endif %}
          </div>
        {% endif %}
      {% endif %}
    {% endfor %}
  </div>
</div>
{% schema %}
{
  "name": "Product Shop Now",
  "tag": "section",
  "settings": [],
  "blocks": [
    {
      "type": "product_detail_block",
      "name": "Product Details",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background Image"
        },
        {
          "type": "image_picker",
          "id": "logo_image",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "inline_richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Button Text"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Shop Now"
    }
  ]
}
{% endschema %}
