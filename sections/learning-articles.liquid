{{ 'section-article.css' | asset_url | stylesheet_tag }}

<div class="article-library">
  <div class="page-width page-small-width">
    {% if section.settings.heading != blank %}
      <h1>{{ section.settings.heading }}</h1>
    {% endif %}
    {% if section.settings.description != blank %}
      {{ section.settings.description }}
    {% endif %}
    {% if section.blocks.size > 0 %}
      <ul class="article-library-list">
        {% for block in section.blocks %}
          {% if block.type == 'article' %}
            {% if block.settings.article_icon != blank and block.settings.article_title != blank %}
            <li>
              <a href="{{ block.settings.view_url }}">
                <span class="article-icons">
                    <img
                      src="{{ block.settings.article_icon |  image_url }}"
                      alt="{{ block.settings.image.alt |  default: block.settings.article_title }}"
                      height="70"
                      width="70"
                      loading="lazy"
                    >
                </span>
                <span class="article-text">{{ block.settings.article_title }}</span>
              </a>
            </li>
            {% endif %}
          {% endif %}
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Article Library",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    }
  ],
  "blocks": [
    {
    "type": "article",
    "name": "Article Item",
    "settings": [
        {
          "type": "url",
          "id": "view_url",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "article_icon",
          "label": "Article Icon"
        },
        {
          "type": "text",
          "id": "article_title",
          "label": "Article Title"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Article Library"
    }
  ]
}
{% endschema %}
