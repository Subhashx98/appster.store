{{ 'customer.css' | asset_url | stylesheet_tag }}

{%- if section.settings.enable_shop_login_button == false -%}
  {%- assign hide_shop_login_button = true -%}
{%- endif -%}

<div
  class="main_background"
  {% if settings.login_signup_image %}
    style="background-image: url({{ settings.login_signup_image | image_url }}); background-size: cover; background-position: center;"
  {% endif %}
>
  <span class="gradient-box"></span>
  <div class="page-width">
    <div class="co-login-container">
      <div class="customer login section-{{ section.id }}-padding co-login-block">
        {% if section.settings.logo_image != blank %}
          <div class="logo_box">
            <img
              src="{{ section.settings.logo_image |  image_url }}"
              alt="{{ section.settings.logo_image.alt |  default:  section.settings.heading_text }}"
              height="46"
              width="78"
              loading="lazy"
              id="login"
              tabindex="-1"
            >
          </div>
        {% endif %}
        <h1 id="recover" tabindex="-1">
          {{ 'customer.recover_password.title' | t }}
        </h1>
        <div class="login_block">
          <p>
            {{ 'customer.recover_password.subtext' | t }}
          </p>

          {%- form 'recover_customer_password' -%}
            {% assign recover_success = form.posted_successfully? %}
            <div class="field">
              <input
                type="email"
                value=""
                name="email"
                id="RecoverEmail"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="RecoverEmail-email-error"
                  autofocus
                {% endif %}
                placeholder="{{ 'customer.login_page.email' | t }}"
              >
              <label for="RecoverEmail">
                {{ 'customer.login_page.email' | t }}
              </label>
            </div>
            {%- if form.errors -%}
              <small id="RecoverEmail-email-error" class="form__message">
                <span class="svg-wrapper">
                  {{- 'icon-error.svg' | inline_asset_content -}}
                </span>
                {{ form.errors.messages.form }}
              </small>
            {%- endif -%}

            <div class="login_button_box">
              <button class="main-btn-large">
                {{ 'customer.login_page.submit' | t }}
              </button>
            </div>

            <div class="account_register_box">
              <a href="#login">
                {{ 'customer.login_page.cancel' | t }}
              </a>
            </div>
          {%- endform -%}
        </div>

        {% if section.settings.heading_text != blank %}
          <h1 class="customer__title" id="login" tabindex="-1">
            {{ section.settings.heading_text }}
          </h1>
        {% endif %}
        {% if section.settings.sub_heading_text != blank %}
          <span class="sub_heading_text" id="login" tabindex="-1">
            {{ section.settings.sub_heading_text }}
          </span>
        {% endif %}

        <div class="login_block">
          {%- if recover_success == true -%}
            <h3 class="form__message" tabindex="-1" autofocus>
              <span class="svg-wrapper">
                {{- 'icon-success.svg' | inline_asset_content -}}
              </span>
              {{ 'customer.recover_password.success' | t }}
            </h3>
          {%- endif -%}
          {%- form 'customer_login', novalidate: 'novalidate' -%}
            {%- if form.errors -%}
              <h2 class="form__message" tabindex="-1" autofocus>
                <span class="visually-hidden">{{ 'accessibility.error' | t }} </span>
                <span class="svg-wrapper">
                  {{- 'icon-error.svg' | inline_asset_content -}}
                </span>
                {{ 'templates.contact.form.error_heading' | t }}
              </h2>
              {{ form.errors | default_errors }}
            {%- endif -%}

            {%- if shop.features.login_with_shop_classic_customer_accounts? -%}
              <section name="sign-in-with-shop-provider">
                {{ shop | login_button: hide_button: hide_shop_login_button }}

                {%- unless hide_shop_login_button -%}
                  <p>
                    {{ 'customer.login_page.alternate_provider_separator' | t }}
                  </p>
                {%- endunless -%}
              </section>
            {%- endif -%}

            <div class="field">
              <input
                type="email"
                name="customer[email]"
                id="CustomerEmail"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                {% if form.errors contains 'form' %}
                  aria-invalid="true"
                {% endif %}
                placeholder="{{ 'customer.login_page.email_address' | t }}"
              >
              <label for="CustomerEmail">
                {{ 'customer.login_page.email_address' | t }}
              </label>
            </div>

            {%- if form.password_needed -%}
              <div class="field">
                <input
                  type="password"
                  value=""
                  name="customer[password]"
                  id="CustomerPassword"
                  autocomplete="current-password"
                  {% if form.errors contains 'form' %}
                    aria-invalid="true"
                  {% endif %}
                  placeholder="{{ 'customer.login_page.password' | t }}"
                >
                <label for="CustomerPassword">
                  {{ 'customer.login_page.password' | t }}
                </label>
              </div>

              <div class="forgot_password_box">
                <a href="#recover">
                  {{ 'customer.login_page.forgot_password' | t }}
                </a>
              </div>
            {%- endif -%}

            <div class="login_button_box">
              <button class="main-btn-large">Login</button>
            </div>

            <div class="account_register_box">
              <span>Don’t have an account?</span>
              <a href="{{ routes.account_register_url }}"> Sign up </a>
            </div>
          {%- endform -%}
        </div>

        <div class="account_register_box b2b_box">
          <span>B2B Customers ?</span>
          <a href="https://shopify.com/89205834033/account">Login</a>
        </div>

        {%- if shop.checkout.guest_login -%}
          <div>
            <hr>
            <h2>{{ 'customer.login_page.guest_title' | t }}</h2>

            {%- form 'guest_login' -%}
              <button>
                {{ 'customer.login_page.guest_continue' | t }}
              </button>
            {%- endform -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-login.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_shop_login_button",
      "label": "t:sections.main-login.shop_login_button.enable",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "logo"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "sub_heading_text",
      "label": "Sub Heading"
    },
    {
      "type": "header",
      "content": "Update & Edit Background",
      "info": "Go to Theme Settings > Retail Login & Signup Image"
    }
  ]
}
{% endschema %}
