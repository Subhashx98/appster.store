          "label": "Heading"
        },
        {
          "type": "inline_richtext",
          "id": "slider_content",
          "label": "Content"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Button Text"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Link"
