{{ 'section-footer.css' | asset_url | stylesheet_tag }}
<footer class="footer">
  <div class="footer_pre_blocks">
    <div class="page-width">
      <div class="left_side_content">

      <div class="call_number_block call_number_mobile_show">
      <a href="tel:{{ section.settings.call_text_1 }}" class="call">
        {{- 'icon-call.svg' | inline_asset_content -}}
        <p>
          <span>{{ section.settings.call_text_1 }}</span>
          <span>({{ section.settings.call_text_2 }})</span>
          <span class="call_text">{{ section.settings.call_text_3 }}</span>
        </p>
      </a>
    </div>

      {% for block in section.blocks %}
        {%- if block.type == 'customer_services' and block.settings.heading_services != blank and block.settings.text_heading != blank -%}
          <div class="blocks">
            <img
              src="{{ block.settings.service_image | image_url }}"
              class="image"
              alt="{{ block.settings.heading_services }}"
              width="100%"
              height="100%"
              loading="lazy"
            >
            <div class="text_content">
              <h5>{{ block.settings.heading_services }}</h5>
              <p>{{ block.settings.text_heading }}</p>
            </div>
          </div>
        {%- endif -%}
      {% endfor %}
      
      </div>

      <div class="call_number_block call_number_mobile_hide">
        <a href="tel:{{ section.settings.call_text_1 }}" class="call">
          {{- 'icon-call.svg' | inline_asset_content -}}
          <p>
            <span>{{ section.settings.call_text_1 }}</span>
            <span>({{ section.settings.call_text_2 }})</span>
            <span class="call_text">{{ section.settings.call_text_3 }}</span>
          </p>
        </a>
      </div>
    </div>
  </div>

  <div class="page-width">
    <section class="footer_top">
      <div class="wrapper_content">
        <div class="grid_item brand_newsletter">
          {% if section.settings.show_newsletter == true %}
            <div class="block_newsletter">
              {% if section.settings.newsletter_text != blank %}
                <h3>{{ section.settings.newsletter_text }}</h3>
              {% endif %}
              {% if section.settings.newsletter_subtitle != blank %}
                <p>{{ section.settings.newsletter_subtitle }}</p>
              {% endif %}
              <div class="footer_klaviyo_newsletter">
                <div class="klaviyo-form-X9mJdp"></div>
             </div>
              {% comment %} <div class="newsletter">
                {%- form 'customer', id: 'ContactFooter', class: 'footer__newsletter newsletter-form' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  <div class="newsletter-form__field-wrapper">
                    <div class="field">
                      <input
                        id="NewsletterForm--{{ section.id }}"
                        type="email"
                        name="contact[email]"
                        class="field__input newsletter_input"
                        value="{{ form.email }}"
                        aria-required="true"
                        autocorrect="off"
                        autocapitalize="off"
                        autocomplete="email"
                        {% if form.errors %}
                          autofocus aria-invalid="true" aria-describedby="ContactFooter-error"
                        {% elsif form.posted_successfully? %}
                          aria-describedby="ContactFooter-success"
                        {% endif %}
                        placeholder="Email Address"
                        required
                      >
                      <label class="field__label" for="NewsletterForm--{{ section.id }}"> Email Address </label>
                      <button
                        type="submit"
                        class="newsletter_form_button button"
                        name="commit"
                        id="Subscribe"
                        aria-label="Subscribe"
                      >
                        Subscribe
                      </button>
                    </div>
                    {%- if form.errors -%}
                      <small class="newsletter-form__message form__message" id="ContactFooter-error">
                        <span class="svg-wrapper">
                          {{- 'icon-error.svg' | inline_asset_content -}}
                        </span>
                        {{- form.errors.translated_fields.email | capitalize }}
                        {{ form.errors.messages.email -}}
                      </small>
                    {%- endif -%}
                  </div>
                  {%- if form.posted_successfully? -%}
                    <h3
                      class="newsletter-form__message newsletter-form__message--success form__message"
                      id="ContactFooter-success"
                      tabindex="-1"
                      autofocus
                    >
                      <span class="svg-wrapper">
                        {{- 'icon-success.svg' | inline_asset_content -}}
                      </span>
                      {{- 'newsletter.success' | t }}
                    </h3>
                  {%- endif -%}
                {%- endform -%}
              </div> {% endcomment %}
            </div>
          {% endif %}
          {% if section.settings.footer_logo != blank %}
            <div class="block_brand">
              <img
                src="{{section.settings.footer_logo |  image_url }}"
                alt="{{ shop.name }}"
                width="180"
                height="70"
              >
            </div>
          {% endif %}
        </div>

        <div class="grid_item footer_menu">
          <div class="footer_menu_list">
           
          {% for block in section.blocks %}
            {% if block.type == "link_list" %}
              <div class="footer_block_list">
                {%- if block.settings.heading != blank -%}
                  <h4 class="footer_block__heading footer_block__accordion-heading mobile_show">
                    {{ block.settings.heading }}
                    <div class="plus-minus">
                      <i class="fa-plus">{{- 'icon-plus-white.svg' | inline_asset_content -}}</i>
                      <i class="fa-minus">{{- 'icon-minus-white.svg' | inline_asset_content -}}</i>
                    </div>
                  </h4>
                {% endif %}
                {%- if block.settings.menu != blank -%}
                  <ul class="menu_block footer_block__accordion-content">
                    {%- for link in block.settings.menu.links -%}
                      <li>
                        <a href="{{ link.url }}">{{ link.title | escape }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </div>
            {% endif %}
          {% endfor %}
          

          </div>
        </div>

        <div class="grid_item contact_social">
          <div class="contact">
            {% if section.settings.address != blank %}
              <div class="link_block">
                <span>
                  {{- 'icon-address.svg' | inline_asset_content }}
                  {{ section.settings.address -}}
                </span>
              </div>
            {% endif %}
            {% if section.settings.email != blank %}
              <div class="link_block">
                <a href="mailto:{{ section.settings.email -}}">
                  {{- 'icon-email.svg' | inline_asset_content }}
                  {{ section.settings.email -}}
                </a>
              </div>
            {% endif %}
          </div>

          <div class="social_block">
            {% if section.settings.social_title != blank %}
              <p>{{ section.settings.social_title }}</p>
            {% endif %}

            <div class="social_icons">
              {% if section.settings.facebook_url != blank %}
                <a href="{{section.settings.facebook_url}}" target="_blank" class="icon" aria-label="Facebook">
                  {{ 'icon-facebook.svg' | inline_asset_content }}
                </a>
              {% endif %}
              {% if section.settings.x_url != blank %}
                <a href="{{section.settings.x_url}}" target="_blank" class="icon" aria-label="X">
                  {{ 'icon-x.svg' | inline_asset_content }}
                </a>
              {% endif %}
              {% if section.settings.instagram_url != blank %}
                <a href="{{section.settings.instagram_url}}" target="_blank" class="icon" aria-label="Instagram">
                  {{ 'icon-instagram.svg' | inline_asset_content }}
                </a>
              {% endif %}
              {% if section.settings.youtube_url != blank %}
                <a href="{{section.settings.youtube_url}}" target="_blank" class="icon" aria-label="YouTube">
                  {{ 'icon-youtube.svg' | inline_asset_content }}
                </a>
              {% endif %}
              {% if section.settings.linkedin_url != blank %}
                <a href="{{section.settings.linkedin_url}}" target="_blank" class="icon" aria-label="LinkedIn">
                  {{ 'icon-linkedin.svg' | inline_asset_content }}
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>

  <div class="footer_content_bottom">
    <div class="page-width">
      <div class="copyright_column">
        {% if section.settings.copyright != blank %}
          <p>© {{ section.settings.copyright }}</p>
        {% endif %}
        {%- if section.settings.footer_menu != blank -%}
          <ul>
            {%- for link in section.settings.footer_menu.links -%}
              <li>
                <a href="{{ link.url }}">{{ link.title | escape }}</a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        <p>
          Made with {{ 'icon-like.svg' | inline_asset_content }}
          and {{ 'icon-cup.svg' | inline_asset_content }}
          <a href="https://arcticgrey.com/" target="_blank">by Arctic Grey</a>
        </p>
      </div>
    </div>
  </div>
</footer>

<script>
  $(document).ready(function () {
    function handleAccordion() {
      if ($(window).width() <= 989) {
        $('.footer_block__accordion-heading').off('click').on('click', function () {
          const $this = $(this);
          const accordionContent = $this.next('.footer_block__accordion-content');

          if ($this.hasClass('active')) {
            $this.removeClass('active');
            accordionContent.stop(true, true).slideUp(500);
          } else {
            $('.footer_block__accordion-heading').removeClass('active');
            $('.footer_block__accordion-content').stop(true, true).slideUp(500);

            $this.addClass('active');
            accordionContent.stop(true, true).slideDown(500);
          }
        });
      } else {
        $('.footer_block__accordion-heading').off('click');
        $('.footer_block__accordion-content').show(); // Ensure all are visible on desktop
      }
    }

    handleAccordion();
    $(window).resize(function () {
      handleAccordion();
    });
  });
</script>


