{{ 'section-featured-item.css' | asset_url | stylesheet_tag }}

<div class="featured-item featured-item--{{ section.id }}">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 class="section-main-title">{{ section.settings.heading }}</h2>
    {% endif %}
    <div class="featured-item-collection">
      <div class="blog-collection-slider">
        {% assign related_products = article.metafields.custom.related_products.value %}
        {% if related_products != blank %}
          {% for product in related_products %}
            <div class="blog-collection-item slick-slide">
              {% render 'card-product',
                card_product: product,
                show_secondary_image: false,
                lazy_load: false,
                section_id: section.id
              %}
            </div>
          {% endfor %}
        {% else %}
          {% assign collection = section.settings.collection %}
          {% for product in collection.products %}
            <div class="blog-collection-item slick-slide">
              {% render 'card-product',
                card_product: product,
                show_secondary_image: false,
                lazy_load: false,
                section_id: section.id
              %}
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
</div>

<script>
  $(document).ready(function () {
    var sectionId = "{{ section.id }}";
    var $slider = $(".featured-item--" + sectionId + " .blog-collection-slider");
    var itemCount = $(".featured-item--" + sectionId + " .blog-collection-item").length;

    if (itemCount < 5 && $(window).width() > 1024) {
      $slider.addClass("no-blog-slider");
    }

    $slider.slick({
      slidesToShow: 4,
      slidesToScroll: 1,
      infinite: false,
      speed: 300,
      lazyLoad: 'ondemand',
      responsive: [
        {
          breakpoint: 1024,
          settings: {
            slidesToShow: 3,
          },
        },
        {
          breakpoint: 768,
          settings: {
            slidesToShow: 2,
          },
        },
      ],
    });
  });
</script>

{% schema %}
{
  "name": "Featured Items",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    }
  ],
  "presets": [
    {
      "name": "Featured Items"
    }
  ]
}
{% endschema %}
