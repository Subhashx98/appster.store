{{ 'section-get-help.css' | asset_url | stylesheet_tag }}
<div class="page-width">
  <div class="get-help">
    {% if section.settings.heading != blank %}
    <h2>{{ section.settings.heading }}</h2>
    {% endif %}
    <ul>
      {% for block in section.blocks %}
        {% if block.type == 'contact_block' %}
            {% if block.settings.link or block.settings.icon or block.settings.title != blank %}
          <li id="{{ block.settings.button_id }}">
            <a href="{{ block.settings.link }}">
                {% if block.settings.icon != blank %}
              <img
                src="{{ block.settings.icon |  image_url }}"
                alt=""
                height="20"
                width="20"
                loading="lazy"
              >
              {% endif %}
              {% if block.settings.title != blank %}
              {{ block.settings.title }}
              {% endif %}
              </a>
          </li>
          {% endif %}
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</div>
{% schema %}
{
  "name": "Additional Way Get Help",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "contact_block",
      "name": "Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_id",
          "label": "Button ID"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Additional Way Get Help"
    }
  ]
}
{% endschema %}
