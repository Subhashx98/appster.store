{% comment %}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-card.css' | asset_url | stylesheet_tag }}
  {{ 'component-article-card.css' | asset_url | stylesheet_tag }}
  {{ 'section-featured-blog.css' | asset_url | stylesheet_tag }}
{% endcomment %}
{{ 'section-home-featured-blog.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign posts_displayed = section.settings.blog.articles_count
  if 3 <= section.settings.blog.articles_count or 3 <= 4
    assign posts_exceed_limit = true
    assign posts_displayed = 3
  endif
-%}
<div class="section-blog-home">
  <div class="page-width">
    <div class="blog-home-featured">
      <div class="heading-block">
        {%- unless section.settings.heading == blank -%}
          {% if section.settings.subheading != blank %}
            <span class="sub-heading">{{ section.settings.subheading }}</span>
          {% endif %}
          <div class="title-wrapper-with-link{% if posts_displayed > 2 %} title-wrapper--self-padded-tablet-down{% else %} title-wrapper--self-padded-mobile{% endif %} title-wrapper--no-top-margin">
            <h2
              id="SectionHeading-{{ section.id }}"
              class="blog__title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
              {% endif %}
            >
              {{ section.settings.heading }}
            </h2>

            {% if section.settings.cta_text != blank and section.settings.cta_url != blank %}
              <div
                class="blog__view-all center{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                {% endif %}
              >
                <a
                  href="{{ section.settings.cta_url }}"
                  class="view-link"
                >
                  {{ section.settings.cta_text }}
                </a>
              </div>
            {% endif %}
          </div>
        {%- endunless -%}
      </div>
      <slider-component class="slider-mobile-gutter{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <ul
          id="Slider-{{ section.id }}"
          class="blog__posts articles-wrapper contains-card contains-card--article{% if settings.blog_card_style == 'standard' %} contains-card--standard{% endif %} grid grid--peek grid--2-col-tablet grid--3-col-desktop slider {% if posts_displayed > 2 %}slider--tablet{% else %}slider--mobile{% endif %}"
          role="list"
        >
          {%- if section.settings.article_1 != blank
            or section.settings.article_2 != blank
            or section.settings.article_3 != blank
          -%}
            {% for i in (1..3) %}
              {% assign article_id = 'article_' | append: i %}
              {% if section.settings[article_id] != blank %}
                <li
                  id="Slide-{{ section.id }}-{{ forloop.index }}"
                  class="blog__post grid__item article slider__slide slider__slide--full-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  {% render 'article-card',
                    article: section.settings[article_id],
                    media_aspect_ratio: 1.66,
                    show_image: section.settings.show_image,
                    show_date: section.settings.show_date,
                    show_author: section.settings.show_author,
                    show_excerpt: true
                  %}
                </li>
              {% endif %}
            {% endfor %}
          {%- elsif section.settings.blog != blank -%}
            {% for blog in section.settings.blog.articles limit: 3 %}
              <li
                id="Slide-{{ section.id }}-{{ forloop.index }}"
                class="blog__post grid__item article slider__slide slider__slide--full-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                {% if settings.animations_reveal_on_scroll %}
                  data-cascade
                  style="--animation-order: {{ forloop.index }};"
                {% endif %}
              >
                {% render 'article-card',
                  article: blog,
                  media_aspect_ratio: 1.66,
                  show_image: section.settings.show_image,
                  show_date: section.settings.show_date,
                  show_author: section.settings.show_author,
                  show_excerpt: true
                %}
              </li>
            {% endfor %}
            {% comment %}
              {% for i in (1..3) -%}
                {%- assign placeholder_image_index = forloop.index0 | modulo: 3 | plus: 1 -%}
                {%- assign placeholder_image = 'blog-apparel-' | append: placeholder_image_index -%}
                <li
                  id="Slide-{{ section.id }}-{{ forloop.index }}"
                  class="blog__post grid__item article slider__slide slider__slide--full-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                  {% if settings.animations_reveal_on_scroll %}
                    data-cascade
                    style="--animation-order: {{ forloop.index }};"
                  {% endif %}
                >
                  <div class="article-card-wrapper card-wrapper{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
                    <div
                      class="
                        card article-card card--{{ settings.blog_card_style }}
                        {% if settings.blog_card_style == 'card' %} color-{{ settings.blog_card_color_scheme }} gradient{% endif %}
                        {% if section.settings.show_image %} card--media{% else %} card--text{% endif %}
                      "
                      style=" {% if settings.blog_card_style == 'standard' %} --ratio-percent: 100%;{% elsif settings.blog_card_style == 'card' %} --ratio-percent: 0%;{% endif %}"
                    >
                      <div
                        class="card__inner{% if settings.blog_card_style == 'standard' %} color-{{ settings.blog_card_color_scheme }} gradient{% endif %} ratio"
                        style="--ratio-percent: 80%;"
                      >
                        {%- if section.settings.show_image == true -%}
                          <div class="article-card__image-wrapper card__media">
                            <div class="article-card__image media">
                              {{ placeholder_image | placeholder_svg_tag: 'blog-placeholder-svg' }}
                            </div>
                          </div>
                        {%- endif -%}
                        <div class="card__content">
                          <div class="card__information">
                            <h3 class="card__heading h5">
                              {{ 'sections.featured_blog.onboarding_title' | t }}
                            </h3>
                            <p class="article-card__excerpt rte-width">
                              {{ 'sections.featured_blog.onboarding_content' | t }}
                            </p>
                          </div>
                        </div>
                      </div>
                      <div class="card__content">
                        <div class="card__information">
                          <h3 class="card__heading h5">
                            {{ 'sections.featured_blog.onboarding_title' | t }}
                          </h3>
                          <p class="article-card__excerpt rte-width">
                            {{ 'sections.featured_blog.onboarding_content' | t }}
                          </p>
                        </div>
                      </div>
                    </div>
                  </div>
                </li>
              {%- endfor -%}
            {% endcomment %}
          {%- endif -%}
        </ul>
      </slider-component>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Home Featured Blog",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.featured-blog.settings.heading.default",
      "label": "t:sections.featured-blog.settings.heading.label"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Sub Heading Text"
    },
    {
      "type": "article",
      "id": "article_1",
      "label": "Article 1"
    },
    {
      "type": "article",
      "id": "article_2",
      "label": "Article 2"
    },
    {
      "type": "article",
      "id": "article_3",
      "label": "Article 3"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "info": "If no articles are selected, blogs from the chosen categories will be displayed."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "default": true,
      "label": "t:sections.featured-blog.settings.show_image.label",
      "info": "t:sections.featured-blog.settings.show_image.info"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "default": true,
      "label": "t:sections.featured-blog.settings.show_date.label"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "default": false,
      "label": "t:sections.featured-blog.settings.show_author.label"
    }
  ],
  "presets": [
    {
      "name": "Home Featured Blog"
    }
  ]
}
{% endschema %}
