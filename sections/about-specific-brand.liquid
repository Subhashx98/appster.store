{{ 'section-about-brand.css' | asset_url | stylesheet_tag }}
{% if section.blocks.size > 0 %}
  {% assign section_show = false %}
  {% for block in section.blocks %}
    {% if block.type == 'about_brand' %}
      {% if block.settings.image != blank or block.settings.description != blank %}
        {% assign section_show = true %}
        {% break %}
      {% endif %}
    {% endif %}
  {% endfor %}
  {% if section_show %}
    <div class="about-brand">
      <div class="page-width page-small-width">
        <h2 class="section-main-title">
          {% if section.settings.heading != blank %}
            {{ section.settings.heading }}
          {% endif %}
        </h2>
        {% for block in section.blocks %}
          {% if block.type == 'about_brand' %}
            <div class="about-brand-content">
              <div class="about-brand-block">
                {% if block.settings.image != blank %}
                  <div class="about-brand-img">
                    <img
                      src="{{ block.settings.image |  image_url   }}"
                      alt="{{ block.settings.image.alt |  default: section.settings.heading }}"
                      height="430"
                      width="650"
                      loading="lazy"
                      class="content-main-img"
                    >
                  </div>
                {% endif %}
              </div>
              <div class="about-brand-block about-brand-text">
                {% if block.settings.description != blank %}
                  {{ block.settings.description }}
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}
{% endif %}
{% schema %}
{
  "name": "About Brand Collection",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "heading"
    }
  ],
  "blocks": [
    {
      "type": "about_brand",
      "name": "Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About Brand Collection"
    }
  ]
}
{% endschema %}
