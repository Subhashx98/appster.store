{{ 'customer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'customer.js' | asset_url }}" defer></script>
<div class="customer addresses main-account" data-customer-addresses>
  <div class="page-width">
    <div class="account-details">
      {% comment %} Account Tab {% endcomment %}
      <div class="account-list-tab">
        <h3>Hello {{ customer.name }}!</h3>
        <a href="javascript:void(0);" class="mobile-dropdown">
          {{- 'icon-loyalty.svg' | inline_asset_content -}}
          Loyalty
        </a>
        <ul class="myList">
          <li class="my-list-item">
            <a href="{{ routes.account_url }}">
              <span class="svg-wrapper">
                {{- 'icon-account.svg' | inline_asset_content -}}
              </span>
              {{ 'customer.account.title' | t }}
            </a>
          </li>
          <li>
            <a href="{{ routes.account_url }}#orderHistory">
              <span class="svg-wrapper">
                {{- 'icon-order.svg' | inline_asset_content -}}
              </span>
              {{ 'customer.orders.title' | t }}
            </a>
          </li>
          <li>
            <a href="{{ routes.account_addresses_url }}">
              <span class="svg-wrapper">
                {{- 'icon-location.svg' | inline_asset_content -}}
              </span>
              {{ 'customer.account.view_addresses' | t }}
            </a>
          </li>
          {% if customer %}
            <li class="my-list-item">
              <a href="/pages/loyalty-and-rewards" class="active">
                <span class="svg-wrapper">
                  {{ 'icon-loyalty.svg' | inline_asset_content }}
                </span>
                Loyalty
              </a>
            </li>
          {% else %}
            <script>
              const currentUrl = encodeURIComponent(window.location.href);
              window.location.href = "{{ routes.account_login_url }}?return_url=" + currentUrl;
            </script>
          {% endif %}
          <li>
            <a href="{{ routes.account_logout_url }}">
              <span class="svg-wrapper">
                {{- 'icon-logout.svg' | inline_asset_content -}}
              </span>
              {{ 'customer.log_out' | t }}
            </a>
          </li>
        </ul>
      </div>
      <div class="loyalty-information">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}
            {%- endcase -%}
          {%- endfor -%}
        </div>

    </div>
  </div>
</div>

<script>
  window.addEventListener('load', () => {
    typeof CustomerAddresses !== 'undefined' && new CustomerAddresses();
  });

  document.addEventListener('DOMContentLoaded', function () {
    const dropdownToggle = document.querySelector('.mobile-dropdown');
    const dropdown = document.querySelector('.myList');
    const dropdownItems = document.querySelectorAll('.my-list-item');

    // Toggle dropdown visibility
    dropdownToggle.addEventListener('click', function (e) {
      e.preventDefault(); // Prevent default link behavior
      dropdown.classList.toggle('open');
    });

    // Update dropdown-toggle text when an item is clicked
    dropdownItems.forEach((item) => {
      item.addEventListener('click', function () {
        // Find the image and text within the clicked item
        const img = this.querySelector('svg').outerHTML;
        const text = this.textContent.trim();

        // Set the dropdown-toggle content to include the image and the selected item text
        dropdownToggle.innerHTML = img + text;
        // Close the dropdown
        dropdown.classList.remove('open');
      });
    });
  });
</script>


{% schema %}
  {
    "name": "Loyalty And Rewards",
    "settings": [
    ],
  
    "blocks": [
      {
        "type": "@app"
      }
    ],
  
    "presets": [
      {
        "name": "Loyalty And Rewards"
      }
    ]
  }
  {% endschema %}
