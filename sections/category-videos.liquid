{{ 'section-customer-service.css' | asset_url | stylesheet_tag }}

{% if section.blocks.size > 0 %}
  <div class="customer-services category-videos">
    <div class="page-width">
      {% if section.settings.heading != blank %}
        <h2>{{ section.settings.heading }}</h2>
      {% endif %}
      <div class="service-block">
        {% for block in section.blocks %}
          {% if block.type == 'link_list' %}
            {% if block.settings.title != blank or block.settings.menu != blank %}
              <div class="service-block-details">
                {% if block.settings.title != blank %}
                  <h3>{{ block.settings.title }}</h3>
                {% endif %}
                {% if block.settings.menu != blank %}
                  <ul>
                    {% for link in block.settings.menu.links %}
                      <li>
                        <a href="{{ link.url }}" target="_blank">{{ link.title | escape }}</a>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Category Videos",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Servicies",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Videos"
    }
  ]
}
{% endschema %}
