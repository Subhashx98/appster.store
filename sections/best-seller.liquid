{{ 'section-best-seller.css' | asset_url | stylesheet_tag }}

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

<div class="page-width">
  <div class="best-seller">
    {% if section.settings.heading != blank
      or section.settings.cta_url != blank
      or section.settings.cta_text != blank
    %}
      <h2 class="section-main-title">
        {{ section.settings.heading }}
        {% if section.settings.cta_url and section.settings.cta_text != blank %}
          <a href="{{ section.settings.cta_url }}" class="view-link">{{ section.settings.cta_text }}</a>
        {% endif %}
      </h2>
    {% endif %}
    <div class="collection-list-slider">
      {% if section.settings.collection != blank %}
        {% for product in section.settings.collection.products limit: section.settings.number_of_products_show %}
          <div class="slick-slide">
            {% render 'card-product',
              card_product: product,
              show_secondary_image: false,
              lazy_load: false,
              section_id: section.id
            %}
          </div>
        {% endfor %}
      {% endif %}
    </div>
    <!-- Progress Bar Container -->
    <div class="progress-bar-main">
      <div class="progress-bg"></div>
    </div>
  </div>
</div>
<script>
  $(document).ready(function () {
    $('.collection-list-slider').each(function () {
      const $slider = $(this);

      $slider.slick({
        slidesToShow: 4,
        slidesToScroll: 4,
        infinite: false,
        speed: 300,
        lazyLoad: 'ondemand',
        responsive: [
          {
            breakpoint: 1024,
            settings: {
              slidesToShow: 3,
              slidesToScroll: 3,
            },
          },
          {
            breakpoint: 768,
            settings: {
              slidesToShow: 2,
              slidesToScroll: 2,
            },
          },
        ],
      });

      // Attach progress bar update on slide change
      $slider.on('beforeChange', function (event, slick, currentSlide, nextSlide) {
        updateProgressBar(slick, nextSlide);
      });

      // Update progress bar initially
      const slickInstance = $slider.slick('getSlick');
      updateProgressBar(slickInstance, 0);
    });

    // Progress bar update function
    function updateProgressBar(slick, nextSlide) {
      const sliderWrapper = slick.$slider.closest('.best-seller')[0]; // updated wrapper class
      const progressBarContainer = sliderWrapper.querySelector('.progress-bg');

      if (!progressBarContainer) return;

      const totalSlides = slick.slideCount;
      const visibleSlides = slick.options.slidesToShow;
      nextSlide = Math.min(nextSlide, totalSlides - 1);

      let progress = ((nextSlide + visibleSlides) / totalSlides) * 100;
      progress = Math.min(progress, 100);

      requestAnimationFrame(() => {
        progressBarContainer.style.width = progress + '%';
      });
    }
  });
</script>
{% schema %}
{
  "name": "Our Best Seller",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Link"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "number_of_products_show",
      "min": 1,
      "max": 12,
      "step": 1,
      "label": "Number Of Products Show",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Our Best Seller"
    }
  ]
}
{% endschema %}
