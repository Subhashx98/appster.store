{{ 'section-related-products.css' | asset_url | stylesheet_tag }}

<div class="page-width">
  <div class="section-title-block">
    {% if section.settings.heading != blank
      or section.settings.cta_url != blank
      or section.settings.cta_text != blank
    %}
      <h2 class="section-main-title">
        {{ section.settings.heading }}
        {% if section.settings.cta_url and section.settings.cta_text != blank %}
          <a href="{{ section.settings.cta_url }}" class="view-link">{{ section.settings.cta_text }}</a>
        {% endif %}
      </h2>
    {% endif %}
    <div class="slick-slider-arrow">
      <div class="prevArrow slide-button"></div>
      <div class="nextArrow slide-button"></div>
    </div>
  </div>

  <div id="related-products-{{ section.id }}" class="">
    <div class="pro-slider">
      <div class="related-products-slider" id="relatedProduct"></div>
    </div>
  </div>
</div>

<script>
  // https://rebuyengine.com/api/v1/products/top_sellers?key=e9cba0549f30f037d811154ba5211d04418f540f&format=pretty
  const requestParameters = new URLSearchParams({
    key: 'e9cba0549f30f037d811154ba5211d04418f540f',
    format: 'pretty',
    limit: 23,
    variant_price_greater_than: "2.47"
  });

  fetch(`https://rebuyengine.com/api/v1/products/recommended?${requestParameters}`)
    .then((response) => response.json())
    .then((data) => {
      if (data.data && data.data.length > 0) {
        let relatedProduct = renderRelatedProductsHtml(data.data);
        $('#relatedProduct').html(relatedProduct);
        $('.related-products-slider').slick({
          slidesToShow: 4,
          slidesToScroll: 4,
          dots: true,
          prevArrow: $('.rebuy-related-products .prevArrow'),
          nextArrow: $('.rebuy-related-products .nextArrow'),
          infinite: false,
          responsive: [
            {
              breakpoint: 1200,
              settings: {
                slidesToShow: 3,
                slidesToScroll: 3,
              },
            },
            {
              breakpoint: 800,
              settings: {
                slidesToShow: 2,
                slidesToScroll: 2,
              },
            },
            {
              breakpoint: 360,
              settings: {
                slidesToShow: 1,
                slidesToScroll: 1,
              },
            },
          ],
        });
      }
    });

  function renderRelatedProductsHtml(products) {
    var productsHtml = '';
    if (products.length > 0) {
      products.forEach((product) => {
        var productBadgeHtml = '';
        if (product.tags.includes('New Arrivals')) {
          productBadgeHtml = '<span class="selling-tag">New Arrivals</span>';
        } else if (product.tags.includes('Best Sellers')) {
          productBadgeHtml = '<span class="selling-tag">Best Sellers</span>';
            } else if (product.tags.includes('Last Chance Items')) {
          productBadgeHtml = '<span class="selling-tag">Last Chance</span>';
        }

        const availableVariants = product.variants.filter(
          (variant) =>
            variant.inventory_management === null ||
            variant.inventory_management === 'shopify' ||
            variant.inventory_quantity > 1
        );

        if (availableVariants.length > 0) {
          productsHtml += `
                <div>
                    <div class="card-wrapper product-card-wrapper underline-links-hover">
                        <div class="card card--standard card--media">
                            <div class="selleing-tag-option">${productBadgeHtml}</div>
                            <div class="card__inner color-scheme-2 gradient">
                                <div class="card__media">
                                    <div class="media media--transparent media--hover-effect">
                                        ${
                                          product.image
                                            ? `<img src="${product.image.src}" alt="${product.title}" loading="lazy">`
                                            : `<img src="https://cdn.shopify.com/s/files/1/0892/0583/4033/files/noimage.png" alt="${product.title}" loading="lazy">`
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="card__content">
                                <div class="card__information">
                                    <h3 class="card__heading h5">
                                        <a href="${product.link}" class="full-unstyled-link">${product.title}</a>
                                    </h3>
                                    <div class="card-information">
                                        <div class="price">
                                            <div class="price__container">
                                                <div class="price__regular">
                                                    <span class="visually-hidden visually-hidden--inline">Regular price</span>
                                                    <span class="price-item price-item--regular">
                                                        $${availableVariants[0].price}
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="quantity-add-cart">
                                ${
                                  availableVariants.length > 1
                                    ? `
                                    <a href="${product.link}" class="main-btn-small btn-blue">
                                        <span>Shop options</span>
                                    </a>
                                `
                                    : `
                                    <p class="quantity-error">
                                      You can't add more product to the cart as we are sold out.
                                    </p>
                                    <form name="customAddToCart" method="post" id="quantity-cart" class="quantity-form">
                                        <input type="hidden" name="form_type" value="product" />
                                        <input type="hidden" name="utf8" value="✓" />
                                        <input type="hidden" name="id" value="${availableVariants[0].id}" />
                                        <input type="hidden" name="product-id" value="${product.id}" class="product-variant-id" />
                                        ${ availableVariants[0].sku ? `<input type="hidden" class="product-variant-part-number" name="properties[Part Number]" value="${availableVariants[0].sku}">` : `` }
                                        <div class="quantity quantity_block" product-id="${product.id}">
                                            <button class="quantity__button decrease-qty" name="minus" type="button">
                                                <span class="svg-wrapper">
                                                    <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                        <path d="M17.5 11C17.5 11.2917 17.4062 11.5312 17.2188 11.7188C17.0312 11.9062 16.7917 12 16.5 12H12H11.5C11 12 11.5 12 11 12C10.5 12 10.7917 12 10.5 12C11 12 10.2083 12 10.5 12C10 12 10.3125 11.8127 10.5 12H10H5.5C5.20833 12 4.96875 11.9062 4.78125 11.7188C4.59375 11.5312 4.5 11.2917 4.5 11C4.5 10.7083 4.59375 10.4688 4.78125 10.2812C4.96875 10.0938 5.20833 10 5.5 10H10L10.5 10C11 10 10.7083 10 11 10C11.2917 10 11 10 11.5 10.0002C12 10.0002 12 10.0002 12 10.0002H16.5C16.7917 10.0002 17.0312 10.0938 17.2188 10.2812C17.4062 10.4688 17.5 10.7083 17.5 11Z" fill="black"></path>
                                                    </svg>
                                                </span>
                                            </button>
                                            <input class="quantity__input" type="number" name="quantity" value="1" min="1" step="1"/>
                                            <button class="quantity__button increase-qty" name="plus" type="button">
                                                <span class="svg-wrapper">
                                                    <svg width="22" height="22" viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                        <path d="M17.5 11C17.5 11.2917 17.4062 11.5312 17.2188 11.7188C17.0312 11.9062 16.7917 12 16.5 12H12V16.5C12 16.7917 11.9062 17.0312 11.7188 17.2188C11.5312 17.4062 11.2917 17.5 11 17.5C10.7083 17.5 10.4688 17.4062 10.2812 17.2188C10.0938 17.0312 10 16.7917 10 16.5V12H5.5C5.20833 12 4.96875 11.9062 4.78125 11.7188C4.59375 11.5312 4.5 11.2917 4.5 11C4.5 10.7083 4.59375 10.4688 4.78125 10.2812C4.96875 10.0938 5.20833 10 5.5 10H10V5.5C10 5.20833 10.0938 4.96875 10.2812 4.78125C10.4688 4.59375 10.7083 4.5 11 4.5C11.2917 4.5 11.5312 4.59375 11.7188 4.78125C11.9062 4.96875 12 5.20833 12 5.5V10H16.5C16.7917 10 17.0312 10.0938 17.2188 10.2812C17.4062 10.4688 17.5 10.7083 17.5 11Z" fill="black"></path>
                                                    </svg>
                                                </span>
                                            </button>
                                        </div>
                                        <button id="product_submit" type="submit" class="main-btn-small btn-blue">
                                            <span>Add to cart </span>
                                              <div class="loading__spinner hidden">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="spinner" viewBox="0 0 66 66">
                                                    <circle stroke-width="6" cx="33" cy="33" r="30" fill="none" class="path"></circle>
                                                </svg>
                                              </div>
                                        </button>
                                    </form>
                                `
                                }
                            </div>
                        </div>
                    </div>
                </div>`;
        }
      });
    }
    return productsHtml;
  }
</script>

{% schema %}
{
  "name": "Rebuy Related Products",
  "tag": "section",
  "class": "rebuy-related-products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Rebuy Related Products"
    }
  ]
}
{% endschema %}
