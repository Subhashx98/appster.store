{{ 'section-multiple-collection.css' | asset_url | stylesheet_tag }}
{{ 'section-collection-video.css' | asset_url | stylesheet_tag }}
{{ 'section-brand-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

{% if section.settings.manufacturer_featured_products != blank %}
  <div class="multiple-collection-list multiple-featured-product">
    <div class="multiple-manufacturer">
      <div class="page-width">
        <div class="multiple-brand-logo">
          <span> </span>
          {% if metaobject.system.handle != blank %}
            <a href="{{ collections[metaobject.system.handle].url }}" class="view-link"> View All </a>
          {% endif %}
        </div>
        <div class="multiple-brand-title">
          {% if section.settings.title != blank %}
            <h2 class="section-main-title">{{ section.settings.title }}</h2>
          {% endif %}
          {% if section.settings.description != blank %}
            {{ section.settings.description }}
          {% endif %}
        </div>
        <div class="multiple-brand-block--outer">
          <div class="multiple-brand-block">
            {% for product in section.settings.manufacturer_featured_products %}
              <div class="multiple-brand-block--inner">
                {% render 'card-product',
                  card_product: product,
                  media_aspect_ratio: 'adapt',
                  image_shape: 'default',
                  show_secondary_image: false,
                  show_vendor: false,
                  show_rating: false,
                  quick_add: 'none',
                  section_id: section.id
                %}
              </div>
            {% endfor %}
          </div>
          <div class="progress-bar-main">
            <div class="progress-bg"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <script>
    $(document).ready(function () {
      function initMultipleBrandSliders() {
        $('.multiple-brand-block').each(function () {
          const $slider = $(this);
          const totalSlides = $slider.find('.multiple-brand-block--inner').length;

          console.log('Total slides:', totalSlides);

          // Detect visible slides based on current screen width
          let slidesToShow = 4;
          if (window.innerWidth < 768) {
            slidesToShow = 2;
          } else if (window.innerWidth < 1024) {
            slidesToShow = 3;
          }

          // If already initialized, destroy first
          if ($slider.hasClass('slick-initialized')) {
            $slider.slick('unslick');
          }

          if (totalSlides <= slidesToShow) {
            $slider.addClass('no-slider');
          } else {
            $slider.removeClass('no-slider');

            $slider.slick({
              slidesToShow: 4,
              slidesToScroll: 4,
              infinite: false,
              speed: 300,
              lazyLoad: 'ondemand',
              responsive: [
                {
                  breakpoint: 1024,
                  settings: {
                    slidesToShow: 3,
                    slidesToScroll: 3,
                  },
                },
                {
                  breakpoint: 768,
                  settings: {
                    slidesToShow: 2,
                    slidesToScroll: 2,
                  },
                },
              ],
            });

            $slider.on('beforeChange', function (event, slick, currentSlide, nextSlide) {
              updateProgressBar(slick, nextSlide);
            });

            const slickInstance = $slider.slick('getSlick');
            updateProgressBar(slickInstance, 0);
          }
        });
      }

      // Call once
      initMultipleBrandSliders();

      // Call on resize
      let resizeTimeout;
      window.addEventListener('resize', function () {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(() => {
          initMultipleBrandSliders();
        }, 300);
      });

      // Progress bar update function
      function updateProgressBar(slick, nextSlide) {
        const sliderWrapper = slick.$slider.closest('.multiple-brand-block--outer')[0]; // updated wrapper class
        const progressBarContainer = sliderWrapper.querySelector('.progress-bg');

        if (!progressBarContainer) return;

        const totalSlides = slick.slideCount;
        const visibleSlides = slick.options.slidesToShow;
        nextSlide = Math.min(nextSlide, totalSlides - 1);

        let progress = ((nextSlide + visibleSlides) / totalSlides) * 100;
        progress = Math.min(progress, 100);

        requestAnimationFrame(() => {
          progressBarContainer.style.width = progress + '%';
        });
      }
    });
  </script>
{% endif %}

{% schema %}
{
  "name": "Manufacturer Product",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "product_list",
      "id": "manufacturer_featured_products",
      "label": "Featured Products"
    }
  ],
  "presets": [
    {
      "name": "Manufacturer Featured Product"
    }
  ]
}
{% endschema %}
