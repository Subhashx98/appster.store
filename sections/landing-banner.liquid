{{ 'section-landing-banner.css' | asset_url | stylesheet_tag }}
{% if section.settings.banner_img != blank
  or section.settings.logo_1 != blank
  or section.settings.logo_2 != blank
  or section.settings.heading != blank
  or section.settings.content != blank
  or section.settings.cta_url != blank
  or section.settings.cta_text != blank
%}
{%  liquid 
    assign padding_top = section.settings.top_padding
%} 
  <div class="landing-banner" data-top-padding="{{ padding_top }}">
    <div class="page-width page-small-width">
      {% if section.settings.banner_img != blank %}
        <span class="landing-banner-img">
          <img
            src="{{ section.settings.banner_img |  image_url }}"
            alt="{{ section.settings.banner_img.alt | default: 'Banner Image' }}"
            height="400"
            width="1200"
            loading="lazy"
          >
        </span>
      {% endif %}
      {% if section.settings.logo_1 != blank
        or section.settings.logo_2 != blank
        or section.settings.heading != blank
        or section.settings.content != blank
        or section.settings.cta_url != blank
        or section.settings.cta_text != blank
      %}
        <div class="marketing-content">
          {% if section.settings.logo_1 != blank or section.settings.logo_2 != blank %}
            <div class="banner-logo">
              {% if section.settings.logo_1 != blank %}
                <span>
                  <img
                    src="{{ section.settings.logo_1 |  image_url }}"
                    alt="{{ section.settings.logo_1.alt | default: 'Logo 1' }}"
                    height="40"
                    width="134"
                    loading="lazy"
                  >
                </span>
              {% endif %}
              {% if section.settings.logo_2 != blank %}
                <span>
                  <img
                    src="{{ section.settings.logo_2 |  image_url }}"
                    alt="{{ section.settings.logo_2.alt | default: 'Logo 2' }}"
                    height="28"
                    width="200"
                    loading="lazy"
                  >
                </span>
              {% endif %}
            </div>
          {% endif %}
          {% if section.settings.heading != blank %}
            <h1>{{ section.settings.heading }}</h1>
          {% endif %}
          {% if section.settings.content != blank %}
            <p>{{ section.settings.content }}</p>
          {% endif %}
          {% if section.settings.cta_url != blank and section.settings.cta_text != blank %}
            <a href="{{ section.settings.cta_url }}" class="main-btn-small">{{ section.settings.cta_text }}</a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
{% endif %}
{% schema %}
{
  "name": "Landing Banner",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_img",
      "label": "Background Image"
    },
    {
        "type": "checkbox",
        "id": "top_padding",
        "label": "Top Spacing",
        "default": false
    },
    {
      "type": "image_picker",
      "id": "logo_1",
      "label": "Logo 1"
    },
    {
      "type": "image_picker",
      "id": "logo_2",
      "label": "Logo 2"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "content",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Landing Banner"
    }
  ]
}
{% endschema %}
