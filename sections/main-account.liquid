{{ 'customer.css' | asset_url | stylesheet_tag }}

<div class="customer account main-account">
  <div class="page-width">
    <div class="account-details">
      {% comment %} Account Tab {% endcomment %}
      <div class="account-list-tab">
        <h3>Hello {{ customer.name }}!</h3>
        <a href="javascript:void(0);" class="mobile-dropdown">
          {{- 'icon-account.svg' | inline_asset_content -}}
          {{ 'customer.account.title' | t }}
        </a>
        <ul class="myList">
          <li class="my-list-item">
            <a href="#myAccount" class="active">
              <span class="svg-wrapper">
                {{- 'icon-account.svg' | inline_asset_content -}}
              </span>
              {{ 'customer.account.title' | t }}
            </a>
          </li>
          <li class="my-list-item">
            <a href="#orderHistory">
              <span class="svg-wrapper">
                {{- 'icon-order.svg' | inline_asset_content -}}
              </span>
              {{ 'customer.orders.title' | t }}
            </a>
          </li>
          <li class="my-list-item">
            <a href="{{ routes.account_addresses_url }}">
              <span class="svg-wrapper">
                {{- 'icon-location.svg' | inline_asset_content -}}
              </span>
              {{ 'customer.account.view_addresses' | t }}
            </a>
          </li>
          <li class="my-list-item">
            <a href="/pages/loyalty-and-rewards">
              <span class="svg-wrapper">
                {{- 'icon-loyalty.svg' | inline_asset_content -}}
              </span>
              Loyalty
            </a>
          </li>
          <li class="my-list-item">
            <a href="{{ routes.account_logout_url }}">
              <span class="svg-wrapper">
                {{- 'icon-logout.svg' | inline_asset_content -}}
              </span>
              {{ 'customer.log_out' | t }}
            </a>
          </li>
        </ul>
      </div>
      {% comment %} Account Information {% endcomment %}
      <div class="account-information">
        {%- render 'account-order-history' -%}
      </div>
    </div>
  </div>
</div>
<script>
$(document).ready(function() {
  // When a link is clicked
  $(".account-list-tab a[href^='#']").click(function(e) {
      e.preventDefault(); // Prevent default link behavior
      
      // Get the target section's offset position
      var target = $(this).attr("href");
      var position = $(target).offset().top;
      
      // Animate the scroll to the target section
      $("body, html").animate({
          scrollTop: position
      }, 500); // 500ms smooth scrolling duration

      // Remove 'active' class from all links and sections
      $(".account-list-tab a[href^='#']").removeClass("active");

      // Add 'active' class to the clicked link
      $(this).addClass("active");

      // Add 'active' class to the corresponding section
      $(target).addClass("active");
  });

  // Function to handle the active class on page load based on the current hash
  function setActiveFromHash() {
      const currentHash = window.location.hash;

      // If there is a valid hash
      if (currentHash) {
          // Remove 'active' class from all links and sections
          $(".account-list-tab a[href^='#']").removeClass("active");

          // Add 'active' class to the link that matches the hash
          $("a[href='" + currentHash + "']").addClass("active");

          // Add 'active' class to the corresponding section
          $(currentHash).addClass("active");
      }
  }
  // Call the function to apply the active class on page load
  setActiveFromHash();
});

document.addEventListener('DOMContentLoaded', function () {
    const dropdownToggle = document.querySelector('.mobile-dropdown');
    const dropdown = document.querySelector('.myList');
    const dropdownItems = document.querySelectorAll('.my-list-item');

    // Toggle dropdown visibility
    dropdownToggle.addEventListener('click', function (e) {
      e.preventDefault(); // Prevent default link behavior
      dropdown.classList.toggle('open');
    });

    // Update dropdown-toggle text when an item is clicked
    dropdownItems.forEach((item) => {
      item.addEventListener('click', function () {
        // Find the image and text within the clicked item
        const img = this.querySelector('svg').outerHTML;
        const text = this.textContent.trim();

        // Set the dropdown-toggle content to include the image and the selected item text
        dropdownToggle.innerHTML = img + text;
        // Close the dropdown
        dropdown.classList.remove('open');
      });
    });
  });

</script>
{% schema %}
{
  "name": "t:sections.main-account.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
