{% comment %}
  Renders a header drawer menu for mobile and desktop.

  Usage:
  {% render 'header-drawer' %}
{% endcomment %}

<header-drawer data-breakpoint="{% if section.settings.menu_type_desktop == 'drawer' %}desktop{% else %}tablet{% endif %}">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary
      class="header__icon header__icon--menu header__icon--summary link focus-inset"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <span>
        {{- 'icon-hamburger.svg' | inline_asset_content -}}
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </summary>
    <div id="menu-drawer" class="gradient menu-drawer motion-reduce color-{{ section.settings.menu_color_scheme }}">
      <div class="menu-drawer__inner-container">
        <div class="menu-drawer__navigation-container">
          <nav class="menu-drawer__navigation">
            <ul class="responsive">
              {%- for link in section.settings.menu.links -%}
                {% for block in section.blocks %}
                  {% assign header_menu = link.title | handle %}
                  {% assign block_header_menu = block.settings.navigation_title | handle %}
                  {% assign menu_available = false %}
                  {% if link.links.size > 0 %}
                    {% if block_header_menu == header_menu %}
                      <li class="menu-has-child">
                        <span class="menu-has-child-container">
                          <a
                            href="{{ link.url }}"
                            {% if link.current %}
                              aria-current="page"
                            {% endif %}
                          >
                            {{ link.title }}
                          </a>
                          <span class="submenu-trigger"></span>
                        </span>
                        {% if link.links.size > 0 %}
                          {%- render 'header-custom-drawer-blocks', block: block, link: link, section: section -%}
                        {% endif %}
                      </li>
                      {% assign menu_available = true %}
                      {% break %}
                    {% endif %}
                  {% endif %}
                {% endfor %}
                {% unless menu_available %}
                  <li class="{%  if link.links.size > 0 %}menu-has-child b2b-click-menu{% endif %}">
                    <a href="{%  if link.links.size > 0 %}javascript:void(0){% else %} {{ link.url }} {% endif %}">
                      <span>{{ link.title }}</span>
                    </a>
                    {% if link.links.size > 0 %}
                      <ul class="sub-menu second-level-menu">
                        {% for secondLevelLink in link.links %}
                          <li>
                            <a href="{{ secondLevelLink.url }}">{{ secondLevelLink.title }}</a>
                          </li>
                        {% endfor %}
                      </ul>
                    {% endif %}
                  </li>
                {% endunless %}
              {% endfor %}
            </ul>
            {% if section.settings.offers_text_1 != blank or section.settings.offers_text_2 != blank %}
              <div class="co-header-megamenu mobile-co-header">
              <div class="header-offers-block">
                {% if section.settings.offers_text_1 != blank -%}
                  <a href="{{ section.settings.offers_url_1 }}">
                    {{- 'icon-special-offers.svg' | inline_asset_content }}
                    {{ section.settings.offers_text_1 -}}
                  </a>
                {%- endif %}
                {% if section.settings.offers_text_2 != blank -%}
                  <a href="{{ section.settings.offers_url_2 }}">
                    {{- 'icon-loyalty.svg' | inline_asset_content }}
                    {{ section.settings.offers_text_2 -}}
                  </a>
                {%- endif %}
              </div>
              </div>
            {% endif %}
          </nav>
        </div>
      </div>
    </div>
  </details>
</header-drawer>
